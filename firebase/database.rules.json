{
  "rules": {
    ".read": false,
    ".write": false,

    "tasks": {
      ".read": true,
      ".write": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'editor'",
      "$taskId": {
        ".write": "data.exists() && !newData.exists()",
        "status": {
          ".write": "data.parent().exists() && newData.isString() && newData.val().matches(/^(triage|toDo|inProgress|awaitFeedback|done)$/)"
        },
        "statusChangedAt": {
          ".write": "data.parent().exists() && newData.isString()"
        }
      }
    },

    "automationUsage": {
      ".read": true,
      ".write": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'editor'"
    },

    "contacts": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'editor'",
      ".write": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'editor'"
    },

    "randomColorsJson": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'editor'",
      ".write": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'editor'"
    },

    "user": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
