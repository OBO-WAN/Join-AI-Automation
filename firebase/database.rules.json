{
  "rules": {
    ".read": false,
    ".write": false,

    "tasks": {
      ".read": true,
      ".write": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'editor'"
    },

    "automationUsage": {
      ".read": true,
      ".write": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'editor'"
    },

    "contacts": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'editor'",
      ".write": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'editor'"
    },

    "randomColorsJson": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'editor'",
      ".write": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'editor'"
    },

    "user": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
