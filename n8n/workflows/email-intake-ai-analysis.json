      "parameters": {
        "text": "=Sender:\n{{ $('Normalize Daily Usage').item.json.sender }}\n\nSubject:\n{{ $('Normalize Daily Usage').item.json.subject }}\n\nBody:\n{{ $('Normalize Daily Usage').item.json.body }}",
        "attributes": {
          "attributes": [
            {
              "name": "=title",
              "description": "Create a concise task title. Remove prefixes such as Re:, Fwd:, Subject:. Do not invent information."
            },
            {
              "name": "category",
              "description": "Classify as exactly one of: Technical Task, User Story, Bug."
            },
            {
              "name": "priority",
              "description": "Return exactly one of: Urgent, Medium, Low. Base this on urgency words and context in the email."
            },
            {
              "name": "deadline",
              "description": "Extract an explicit deadline if present and return it as YYYY-MM-DD. If no deadline is stated, return an empty string."
            },
            {
              "name": "description",
              "description": "Summarize the requested work clearly and concisely while preserving the important requirements."
            },
            {
              "name": "subTasks",
              "description": "Extract explicitly requested action items that are part of the main task, including numbered or bulleted lists even when the sender does not use the word \"subtasks\". Return them as one string separated exactly by |||. Remove numbering and bullet characters. If no explicit action items exist, return an empty string. Do not invent subtasks. Example: Beamer testen|||Namensschilder vorbereiten|||Getränke bestellen"
            }
          ]
        },
        "options": {}
      },
