        "jsonBody": "={{\n  {\n    title: $json.output.title,\n    description: $json.output.description,\n    dueDate: $json.output.deadline\n      ? DateTime.fromISO($json.output.deadline).toFormat(\"dd-MM-yyyy\")\n      : \"\",\n    category: $json.output.category,\n    priority: $json.output.priority,\n    status: \"triage\",\n    assignedTo: [],\n    subTasks: String($json.output.subTasks || \"\")\n      .split(\"|||\")\n      .map((task) => task.trim())\n      .filter(Boolean)\n      .map((task) => ({\n        task,\n        done: false\n      })),\n    creator: {\n      type: \"external\",\n      name:\n        $(\"Normalize Daily Usage\")\n          .item.json.sender\n          .replace(/\\s*<[^>]+>\\s*$/, \"\")\n          .trim() || null,\n      email:\n        (\n          $(\"Normalize Daily Usage\")\n            .item.json.sender\n            .match(/<([^>]+)>/) || []\n        )[1] || $(\"Normalize Daily Usage\").item.json.sender\n    },\n    source: {\n      type: \"email\",\n      aiGenerated: true,\n      messageId:\n        $(\"Email Intake - Daily Limit\")\n          .item.json.metadata[\"message-id\"]\n    },\n    createdAt: $now.toISO()\n  }\n}}",
